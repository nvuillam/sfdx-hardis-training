<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>A planned installation with a crew and a date is scheduled: the status follows the facts rather than waiting for somebody to change it.</description>
        <name>Move_To_Scheduled</name>
        <label>Move To Scheduled</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Flat_Roof_Minimum</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>US-034: a flat roof gets a crew of at least three.</description>
        <name>Raise_Crew_To_Three</name>
        <label>Raise Crew To Three</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.Crew_Size__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Is it a flat roof with fewer than three people?</description>
        <name>Flat_Roof_Minimum</name>
        <label>Flat Roof Minimum</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Not a flat roof, or enough people</defaultConnectorLabel>
        <rules>
            <name>Flat_Roof_Too_Few</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Roof_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Flat</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Crew_Size__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Raise_Crew_To_Three</targetReference>
            </connector>
            <label>Flat roof, fewer than three</label>
        </rules>
    </decisions>
    <description>When a planner puts a crew on a planned installation that already has a date, the installation moves to Scheduled on its own.</description>
    <environments>Default</environments>
    <interviewLabel>Installation Assign Crew {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Installation Assign Crew</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Move_To_Scheduled</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Crew_Size__c})),
  NOT(ISBLANK({!$Record.Install_Date__c})),
  ISPICKVAL({!$Record.Status__c}, &quot;Planned&quot;)
)</filterFormula>
        <object>Installation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
