<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description>US-041: tells the planner which checklist is not finished, on the record itself.</description>
        <name>Refuse_The_Close</name>
        <label>Refuse The Close</label>
        <locationX>50</locationX>
        <locationY>420</locationY>
        <customErrorMessages>
            <errorMessage>This installation still has handover items that are not done. Finish the checklist before closing it.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>US-041: is there at least one handover item left to do on this installation?</description>
        <name>Checklist_Still_Open</name>
        <label>Checklist Still Open</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>Everything is done</defaultConnectorLabel>
        <rules>
            <name>Items_Left</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Open_Handover_Items</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Refuse_The_Close</targetReference>
            </connector>
            <label>Items Left</label>
        </rules>
    </decisions>
    <description>US-041: an installation cannot be closed while a line of its handover checklist is still open.</description>
    <environments>Default</environments>
    <interviewLabel>Installation Close Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Installation Close Check</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>US-041: the checklist lines of this installation that are not ticked yet.</description>
        <name>Open_Handover_Items</name>
        <label>Open Handover Items</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Checklist_Still_Open</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Installation__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Done__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Handover_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Open_Handover_Items</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Status__c}, &quot;Completed&quot;)</filterFormula>
        <object>Installation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
